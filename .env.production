# Loaded automatically by `vite build` (default mode is "production") — this is why
# `npm run android:bundle` / `npm run android:sync` need no extra flags or exported
# env vars to ship the real rewarded ad unit. Not a secret: ad unit IDs are meant to
# be embedded in a shipped app, unlike the AdMob App ID's password-equivalent, the
# release keystore (see README.md, "Сборка под Android").
VITE_ADMOB_REWARDED_UNIT_ID=ca-app-pub-1918664364236470/8943486173
